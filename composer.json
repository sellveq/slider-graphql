{
    "name": "selveq/slider-graphql",
    "description": "Magento 2 Slider GraphQl extension for ScandiPWA theme",
    "type": "magento2-module",
    "version": "3.0.0",
    "license": [
        "OSL-3.0"
    ],
    "authors": [
        {
            "name": "Scandiweb",
            "homepage": "https://scandiweb.com",
            "role": "Original author"
        },
        {
            "name": "Selveq",
            "homepage": "https://selveq.com",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/selveq/slider-graphql/issues",
        "source": "https://github.com/selveq/slider-graphql"
    },
    "require": {
        "php": "^8.3",
        "magento/framework": "^103.0",
        "magento/module-graph-ql": "^100.4",
        "magento/module-graph-ql-cache": "^100.4",
        "selveq/slider": "^3.0"
    },
    "replace": {
        "scandipwa/slider-graphql": "*"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "ScandiPWA\\SliderGraphQl\\": "src/"
        }
    },
    "archive": {
        "exclude": [
            "/.github",
            "/.gitignore"
        ]
    }
}
